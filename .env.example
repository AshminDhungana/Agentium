# Root environment example for `docker compose`.
# Copy to `.env` and fill in. Variables with defaults (shown via :- syntax in compose)
# will work without a .env file. Secrets left blank should be generated via `make setup`.
# This file is committed; `.env` is gitignored and must NOT be committed.

# ─────────────────────────────────────────────────────
# 🔐 Core Security (auto-generated by `make setup`)
# ─────────────────────────────────────────────────────
# Application secret key (used for JWT, session signing, etc.)
SECRET_KEY=a6b1f393fed4b7d1611577a0ee3b32f6f8db91e1b04e46aa77e83709f58e2984

# Encryption key for sensitive data at rest (Fernet format)
ENCRYPTION_KEY=ZXEectOcdOcriqTCylzEIt0fhO5vR4ZTSeB_VO1cqoU=

# Voice JWT secret for WebSocket authentication
VOICE_JWT_SECRET=L9NtEbjjvukHFWv37HfAX5ah5FvI27cz

# MinIO (object storage) — SECURITY: never use minioadmin/minioadmin in production
# `make setup` generates unique credentials and writes them here.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────
# 🌍 Application Configuration (have defaults)
# ─────────────────────────────────────────────────────
# Environment: development / production / testing
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL for the API (used for webhooks, federation, etc.)
APP_BASE_URL=http://localhost:8000

# Federation (multi-instance) settings
FEDERATION_ENABLED=false
FEDERATION_INSTANCE_NAME=Agentium-Primary
FEDERATION_INSTANCE_URL=https://your-agentium.example.com
FEDERATION_SHARED_SECRET=50c7f2c86e624a8d11a167080fa981013aa44a7b24ee76930cb44cf6b951c985

# Voice token duration (minutes)
VOICE_TOKEN_DURATION_MINUTES=30

# Logging level
LOG_LEVEL=info

# ─────────────────────────────────────────────────────
# 🔧 External API Keys (optional - leave blank if unused)
# ─────────────────────────────────────────────────────
# Search APIs
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# Stock data
STOCK_API_KEY=
STOCK_API_PROVIDER=yfinance

# Broker integration
DEFAULT_BROKER_EMAIL=

# Push notifications
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.agentium.app
PUSH_NOTIFICATION_ENABLED=false

# WhatsApp bridge
WHATSAPP_BRIDGE_TOKEN=changeme

# ─────────────────────────────────────────────────────
# 🗄️ Storage & Database (defaults work in Docker)
# ─────────────────────────────────────────────────────
# S3/MinIO bucket name
S3_BUCKET_NAME=agentium-media

# Local fallback storage path (used when MinIO unavailable)
STORAGE_LOCAL_PATH=/app/data/uploads

# ─────────────────────────────────────────────────────
# 🖥️ Platform-specific (auto-filled on Windows)
# ─────────────────────────────────────────────────────
# Windows user profile path (for host workspace mounting)
# On Linux/macOS this is $HOME; on Windows it's %USERPROFILE%
USERPROFILE=

# ─────────────────────────────────────────────────────
# 🧪 Testing
# ─────────────────────────────────────────────────────
TESTING=false